PORT=5000
MONGO_URI=mongodb://localhost:27017/smart-eval
JWT_SECRET=change_this_to_a_long_random_secret
GEMINI_API_KEY=<enter-your-gemini-api-key>

# Optional: override the Gemini model name without touching code
GEMINI_MODEL=gemini-3-flash-preview

# OCR_MODE: "mock" uses simulated placeholder text (no Google account needed,
# good for testing the grading/PDF pipeline). "google" uses real Cloud Vision
# OCR and is required to actually read handwritten/scanned answer sheets.
OCR_MODE=google
GOOGLE_APPLICATION_CREDENTIALS=./google-key.json
